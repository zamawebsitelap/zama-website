---
// The ZAMA wordmark. Uses the provided logo assets for a more distinctive brand mark.
import { site } from '../config/site';

interface Props {
  /** 'dark' = charcoal text (for light backgrounds), 'light' = cream text. */
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: className = '' } = Astro.props;
const logoSrc = tone === 'light' ? '/images/zama-wordmark-tagline.png' : '/images/zama-logo-black.png';
---

<img
  src={logoSrc}
  alt={site.name}
  class:list={['h-12 w-auto object-contain', className]}
  aria-hidden="false"
/>
<span class="sr-only">{site.name} - {site.tagline}</span>
