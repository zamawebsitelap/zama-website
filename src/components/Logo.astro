---
// The ZAMA wordmark. Uses transparent logo assets for a cleaner header/footer lockup.
import { site } from '../config/site';

interface Props {
  /** 'dark' = charcoal text (for light backgrounds), 'light' = cream text. */
  tone?: 'dark' | 'light';
  class?: string;
}
const { tone = 'dark', class: className = '' } = Astro.props;
const logoSrc = tone === 'light' ? '/images/zama-footer-visible.png' : '/images/zama-header-page13.png';
---

<img
  src={logoSrc}
  alt={site.name}
  class:list={['h-12 w-auto object-contain', className]}
  aria-hidden="false"
/>
<span class="sr-only">{site.name} - {site.tagline}</span>
